{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Subscriber email address"
    },
    "name": {
      "type": "string",
      "description": "Subscriber name"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "software_updates",
          "release_announcements",
          "workflow_tips",
          "events_webinars"
        ]
      },
      "description": "Topics the subscriber wants to receive"
    }
  },
  "required": [
    "email"
  ]
}