---
// ProductCard.astro — product card tile linking to /products/[id]
interface Product {
  id: string;
  name: string;
  shortName: string;
  tagline: string;
  description: string;
  image: string;
  path: string;
  platform: string;
  category: string;
}
interface Props {
  product: Product;
  compact?: boolean;
}
const { product, compact = false } = Astro.props;
---

<a
  href={product.path}
  class="group card-anim bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-slate-300"
>
  <div class="relative aspect-square overflow-hidden">
    <img
      src={product.image}
      alt={product.name}
      loading="lazy"
      class="relative w-full h-full object-contain px-8 pt-6 pb-10 transition-transform duration-700 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06] group-hover:-rotate-[1.5deg] group-hover:-translate-y-2.5"
    />
  </div>
  <div class="p-5 border-t border-slate-100">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-medium text-red-600 bg-red-50 px-2 py-0.5 rounded-full">
        {product.platform}
      </span>
      <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
        {product.category}
      </span>
    </div>
    <h3 class="text-lg font-bold text-slate-900 mb-1 group-hover:text-red-600 transition-colors">
      {product.name}
    </h3>
    <p class="text-sm text-slate-500 mb-3">{product.tagline}</p>
    {!compact && (
      <p class="text-sm text-slate-600 mb-4 line-clamp-2">{product.description}</p>
    )}
    <span class="inline-flex items-center gap-1 text-sm font-semibold text-red-600 group-hover:gap-2.5 transition-all">
      Learn more
      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
