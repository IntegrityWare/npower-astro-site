---
import TrialRegistrationForm from './TrialRegistrationForm';
import { STUDIO_DEMO } from '@/lib/trialDownloads';
---
<div id="studio-trial-registration" aria-labelledby="studio-registration-title">
  <div class="mb-8">
    <h2 id="studio-registration-title" class="text-2xl md:text-3xl font-bold text-slate-900 mb-2">Register for your download</h2>
    <p class="text-slate-600">Complete the form below to register for standalone trial downloads. No SOLIDWORKS installation is required.</p>
  </div>
  <TrialRegistrationForm campaign={STUDIO_DEMO} client:load />
</div>
