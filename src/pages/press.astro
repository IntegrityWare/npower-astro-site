---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { PRESS_COVERAGE, PRESS_RELEASES } from '@/lib/pressData.js';
import { absoluteUrl } from '@/lib/siteUrl.js';

const displayDate = (date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));

const pressItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${absoluteUrl('/press')}#itemlist`,
  name: 'nPower Software press',
  url: absoluteUrl('/press'),
  itemListElement: [...PRESS_COVERAGE, ...PRESS_RELEASES].map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    url: item.url.startsWith('http') ? item.url : absoluteUrl(item.url),
  })),
};
---

<SiteLayout
  title="Press | nPower Software"
  description="Company announcements and independent coverage of nPower Software, including the Power Surfacing VIZ 1.0 release and Jon Peddie Research."
>
  <script type="application/ld+json" set:html={JSON.stringify(pressItemList)} />
  <header class="bg-neutral-950 text-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-400 mb-6">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true" class="mx-2">/</span>
        <a href="/resources/" class="hover:text-white">Learn</a><span aria-hidden="true" class="mx-2">/</span>
        <span class="text-slate-200">Press</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-500 mb-4">News and announcements</p>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">Press</h1>
      <p class="max-w-3xl text-lg md:text-xl leading-8 text-slate-300">
        Company announcements and independent coverage of nPower Software products.
      </p>
    </div>
  </header>

  <main class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section aria-labelledby="press-coverage">
        <h2 id="press-coverage" class="text-3xl font-bold text-slate-900 mb-8">In the news</h2>
        <ol class="space-y-8">
          {PRESS_COVERAGE.map((item) => (
            <li class="rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-wider text-red-600 mb-3">{item.source}</p>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">{item.title}</h3>
              <p class="text-sm text-slate-500 mb-4">
                {displayDate(item.date)}{item.author ? ` · ${item.author}` : ''}
              </p>
              <p class="text-slate-600 leading-7 mb-5">{item.summary}</p>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-red-600 hover:text-red-700 hover:underline">
                Read at {item.source}
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="press-releases" class="mt-16">
        <h2 id="press-releases" class="text-3xl font-bold text-slate-900 mb-8">Press releases</h2>
        <ol class="space-y-8">
          {PRESS_RELEASES.map((item) => (
            <li class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-8">
              <p class="text-sm font-semibold uppercase tracking-wider text-red-600 mb-3">{item.source}</p>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">{item.title}</h3>
              <p class="text-sm text-slate-500 mb-4">{displayDate(item.date)}</p>
              <p class="text-slate-600 leading-7 mb-5">{item.summary}</p>
              <a href={item.url} class="font-semibold text-red-600 hover:text-red-700 hover:underline">
                Read the press release
              </a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</SiteLayout>
