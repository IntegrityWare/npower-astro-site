---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | nPower Software" noindex={true}>
  <div class="min-h-screen flex items-center justify-center bg-white">
    <div class="text-center max-w-md px-4">
      <p class="text-8xl font-bold text-red-600 mb-4">404</p>
      <h1 class="text-2xl font-bold text-slate-900 mb-4">Page Not Found</h1>
      <p class="text-slate-600 mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors">
        Go to Home
      </a>
    </div>
  </div>
</BaseLayout>
