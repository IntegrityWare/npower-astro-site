---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { ORGANIZATION_ID, absoluteUrl, siteId } from '@/lib/siteUrl.js';

const aboutPageLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': absoluteUrl('/about#webpage'),
  url: absoluteUrl('/about'),
  name: 'About IntegrityWare and nPower Software',
  description: 'Company history, leadership, technology, and location information for IntegrityWare, Inc. and its nPower Software division.',
  mainEntity: {
    '@id': ORGANIZATION_ID,
  },
  isPartOf: {
    '@id': siteId('website'),
  },
  about: [
    { '@id': ORGANIZATION_ID },
    { '@id': siteId('npower-software') },
    { '@id': siteId('power-surfacing') },
    { '@id': absoluteUrl('/about#gary-crocker') },
    { '@id': absoluteUrl('/about#david-gill') },
  ],
  inLanguage: 'en-US',
};
---

<SiteLayout
  title="About IntegrityWare & nPower Software | Power Surfacing"
  description="Learn about IntegrityWare, Inc., its nPower Software division, the Power Surfacing product line, company leadership, Solids# technology, and our San Diego history."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageLd)} />
  <header class="bg-neutral-950 text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span class="text-slate-200">About</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-500 mb-4">Our company</p>
      <h1 class="max-w-4xl text-4xl md:text-6xl font-extrabold tracking-tight mb-6">
        Advanced geometry, built into practical design tools
      </h1>
      <p class="max-w-3xl text-lg md:text-xl leading-8 text-slate-300">
        IntegrityWare, Inc. develops advanced 3D geometric modeling technology. Its nPower
        Software division brings that technology to designers and engineers through Power
        Surfacing, our flagship product line.
      </p>
    </div>
  </header>

  <section class="bg-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <article class="rounded-2xl border border-slate-200 p-7 shadow-sm">
          <p class="text-sm font-semibold text-red-600 mb-2">Parent company</p>
          <h2 class="text-2xl font-bold text-slate-900 mb-4">IntegrityWare, Inc.</h2>
          <p class="text-slate-600 leading-7">
            Founded in 1996, IntegrityWare specializes in high-performance 3D geometric modeling
            software, including solid, surface, curve, polygonal, subdivision, and non-manifold
            modeling technology.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 p-7 shadow-sm">
          <p class="text-sm font-semibold text-red-600 mb-2">Software division</p>
          <h2 class="text-2xl font-bold text-slate-900 mb-4">nPower Software</h2>
          <p class="text-slate-600 leading-7">
            Established as an IntegrityWare division in 2002, nPower Software turns the company’s
            underlying geometry technology into focused applications and plug-ins for 3D design,
            CAD, and reverse-engineering professionals.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 p-7 shadow-sm">
          <p class="text-sm font-semibold text-red-600 mb-2">Flagship product line</p>
          <h2 class="text-2xl font-bold text-slate-900 mb-4">Power Surfacing</h2>
          <p class="text-slate-600 leading-7">
            Power Surfacing combines intuitive Sub-D modeling with precise CAD workflows. The
            product family supports freeform design, scan-to-CAD, mesh-to-CAD, reverse
            engineering, and advanced shelling in standalone and SOLIDWORKS environments.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-red-600 mb-3">Company history</p>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Nearly three decades of geometry development</h2>
        <p class="text-slate-600 leading-7 mb-8">
          IntegrityWare began by building geometry libraries for developers, then expanded into
          end-user applications. That combination—developing both the mathematical foundation and
          the products that rely on it—continues to shape our approach to reliability, performance,
          and practical workflow design.
        </p>
        <ol class="space-y-6">
          <li class="grid grid-cols-[4.5rem_1fr] gap-4">
            <span class="font-bold text-red-600">1996</span>
            <p class="text-slate-700">IntegrityWare, Inc. is formed to develop advanced geometric modeling technology.</p>
          </li>
          <li class="grid grid-cols-[4.5rem_1fr] gap-4">
            <span class="font-bold text-red-600">2002</span>
            <p class="text-slate-700">nPower Software begins developing applications and plug-ins based on IntegrityWare technology.</p>
          </li>
          <li class="grid grid-cols-[4.5rem_1fr] gap-4">
            <span class="font-bold text-red-600">2007</span>
            <p class="text-slate-700">New development increasingly centers on the C#-based Solids# geometry kernel.</p>
          </li>
          <li class="grid grid-cols-[4.5rem_1fr] gap-4">
            <span class="font-bold text-red-600">Today</span>
            <p class="text-slate-700">Power Surfacing delivers IntegrityWare geometry technology in design and reverse-engineering tools used by CAD professionals.</p>
          </li>
        </ol>
      </div>

      <aside class="rounded-2xl bg-neutral-950 text-white p-8 md:p-10">
        <p class="text-sm font-semibold uppercase tracking-wider text-red-500 mb-3">Leadership</p>
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-bold mb-2">Gary Crocker</h2>
            <p class="text-red-400 font-semibold mb-4">Founder and Chief Technology Officer</p>
            <p class="text-slate-300 leading-7">
              Gary Crocker founded IntegrityWare and currently serves as CTO, guiding the company’s
              geometric modeling research, core technology, and long-term technical direction.
            </p>
            <p class="text-slate-300 leading-7 mt-4">
              He earned a bachelor’s degree in mathematics from the University of Maine at Orono
              and a master’s degree in computer and systems engineering from Rensselaer Polytechnic
              Institute. He began his career at General Electric Research and Development in
              Schenectady, New York, working in computer graphics and geometric modeling. After two
              years, he transferred to GE’s CALMA division to work on its CAD product. CALMA was
              acquired by Prime Computer and later became part of Computervision. Crocker continued
              his work at Computervision until 1996, when he founded IntegrityWare to develop
              advanced geometric modeling tools.
            </p>
          </div>
          <div class="border-t border-white/15 pt-8">
            <h2 class="text-2xl font-bold mb-2">David Gill</h2>
            <p class="text-red-400 font-semibold mb-4">President, IntegrityWare, Inc.</p>
            <p class="text-slate-300 leading-7">
              David Gill leads company operations and is closely involved with nPower Software’s
              products, licensing, and customer-support work.
            </p>
          </div>
        </div>
        <a href="/publications" class="inline-flex mt-8 font-semibold text-red-400 hover:text-red-300 hover:underline">
          View published research and technical reports
        </a>
        <a href="/patents" class="inline-flex mt-3 font-semibold text-red-400 hover:text-red-300 hover:underline">
          View issued U.S. patents
        </a>
      </aside>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-red-600 mb-3">Core technology</p>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-5">Powered by Solids#</h2>
        <p class="text-slate-600 leading-7 mb-5">
          Solids# is IntegrityWare’s geometric modeling kernel, implemented in C#. It provides the
          mathematical and topological foundation behind Power Surfacing’s solid, surface, mesh,
          subdivision, and NURBS capabilities.
        </p>
        <p class="text-slate-600 leading-7 mb-7">
          Its technology helps bridge freeform Sub-D design and precise CAD representation,
          including Sub-D-to-NURBS conversion, advanced surfacing, mesh processing, and reverse
          engineering workflows.
        </p>
        <a href="/technology" class="inline-flex items-center justify-center rounded-lg bg-red-600 px-5 py-3 font-semibold text-white hover:bg-red-700 transition-colors">
          Explore Solids# technology
        </a>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 md:p-12">
        <img src="/assets/tech-logo.webp" alt="Solids# technology used by Power Surfacing" class="w-full h-auto object-contain" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-red-600 mb-3">San Diego, California</p>
        <h2 class="text-3xl font-bold text-slate-900 mb-5">Company headquarters</h2>
        <address class="not-italic text-lg text-slate-700 leading-8">
          IntegrityWare, Inc.<br />
          16486 Bernardo Center Drive, Suite 309<br />
          San Diego, CA 92128<br />
          United States
        </address>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-3">Talk with our team</h2>
        <p class="text-slate-600 leading-7 mb-6">
          Contact nPower Software for product questions, licensing, demonstrations, or technical support.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="rounded-lg bg-red-600 px-5 py-3 font-semibold text-white hover:bg-red-700 transition-colors">Contact us</a>
          <a href="/products" class="rounded-lg border border-slate-300 px-5 py-3 font-semibold text-slate-800 hover:border-slate-400 hover:bg-slate-50 transition-colors">View products</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
