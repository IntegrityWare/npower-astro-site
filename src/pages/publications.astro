---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { PUBLICATIONS, TECHNICAL_DOCUMENTS } from '@/lib/publicationsData.js';
import { publicationsItemList } from '@/seo-content/publicationsStructuredData.js';
---

<SiteLayout
  title="Gary Crocker Publications | Geometry & CAD Research"
  description="Published research and technical reports by IntegrityWare founder Gary Crocker on computer graphics, solid modeling, boundary evaluation, and nonmanifold geometry."
  canonicalPath="/publications"
>
  <script type="application/ld+json" set:html={JSON.stringify(publicationsItemList)} />
  <header class="bg-neutral-950 text-white py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="text-sm text-slate-400 mb-6">
        <a href="/" class="hover:text-white">Home</a><span aria-hidden="true" class="mx-2">/</span>
        <a href="/about" class="hover:text-white">About</a><span aria-hidden="true" class="mx-2">/</span>
        <span class="text-slate-200">Publications</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-500 mb-4">Research and technical expertise</p>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">Published papers and technical reports</h1>
      <p class="max-w-3xl text-lg md:text-xl leading-8 text-slate-300">
        Research by Gary Crocker, founder and CTO of IntegrityWare, on computer graphics,
        geometric and solid modeling, boundary evaluation, and editable nonmanifold representations.
      </p>
    </div>
  </header>

  <main class="bg-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <section aria-labelledby="published-papers">
        <h2 id="published-papers" class="text-3xl font-bold text-slate-900 mb-8">Published papers</h2>
        <ol class="space-y-8">
          {PUBLICATIONS.map((work, index) => (
            <li class="rounded-2xl border border-slate-200 p-6 md:p-8 shadow-sm">
              <div class="flex gap-4">
                <span class="text-red-600 font-bold">{index + 1}</span>
                <div>
                  <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">{work.title}</h3>
                  <p class="text-slate-700 mb-2">{work.authors.join(' and ')}</p>
                  <p class="text-sm leading-6 text-slate-500 mb-4">
                    <cite>{work.publication}</cite>, vol. {work.volume}, no. {work.issue}, pp. {work.pages}, {work.dateLabel}.
                  </p>
                  <p class="text-slate-600 leading-7 mb-5">{work.summary}</p>
                  <a href={`https://doi.org/${work.doi}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-red-600 hover:text-red-700 hover:underline">
                    DOI: {work.doi}
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="technical-documents" class="mt-16">
        <h2 id="technical-documents" class="text-3xl font-bold text-slate-900 mb-8">Additional technical documents</h2>
        <ol class="space-y-8">
          {TECHNICAL_DOCUMENTS.map((work, index) => (
            <li class="rounded-2xl border border-slate-200 bg-slate-50 p-6 md:p-8">
              <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">{work.title}</h3>
              <p class="text-slate-700 mb-2">{work.authors.join(' and ')}</p>
              <p class="text-sm text-slate-500 mb-4">
                {work.type}{work.publisher ? `, ${work.publisher}` : ''}, {work.dateLabel ?? work.date}.
              </p>
              <p class="text-slate-600 leading-7">{work.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</SiteLayout>
