---
import { PRODUCTS } from '@/lib/siteData.js';
import SiteLayout from '@/layouts/SiteLayout.astro';
import ProductPageContent from './_ProductPage.jsx';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({
    params: { productId: p.id },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const title = (product.pageTitle ?? product.name) + ' | nPower Software';
const description = product.pageDescription ?? product.description;
---
<SiteLayout title={title} description={description} image={product.image}>
  <ProductPageContent product={product} />
</SiteLayout>
