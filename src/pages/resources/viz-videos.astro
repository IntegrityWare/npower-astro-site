---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';

import { VIZ_VIDEOS as videos, vizVideoStructuredData } from '@/lib/vizVideos.js';
---

<SiteLayout title="Power Surfacing VIZ Videos | Tutorials | nPower Software"
  description="Watch getting-started, materials, animation, geometry modification, and AI tutorials for Power Surfacing VIZ, including Cursor and Codex setup, creating sketches from pictures, creating animations, and combining AI with direct editing. Find installation instructions and downloads.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": videos.map(vizVideoStructuredData),
  })} />
  <PageHero title="Power Surfacing VIZ Videos"
    subtitle="Learn Power Surfacing VIZ with step-by-step videos. Start with the introduction, then explore more tutorials as they become available."
    breadcrumbs={[{label:'Resources',path:'/resources/'},{label:'VIZ Videos'}]}
    actions={[{label:'Start your free VIZ trial',path:'/pricing/downloads/studio/#visualize'},{label:'Installation & Evaluation Guide',path:'/support/viz-beta/'}]} />

  <section class="py-12 md:py-16 bg-white" aria-label="VIZ video tutorials">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="mb-6 text-sm text-slate-600">Play a tutorial below, or open it on YouTube.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {videos.map((video) => (
          <article id={video.id} class="scroll-mt-28 flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <div class="relative aspect-video bg-slate-950">
              <iframe
                class="w-full h-full"
                width="480" height="270"
                src={'https://www.youtube.com/embed/' + video.youtubeId}
                title={video.title}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
            <div class="p-5 flex-1">
              <p class="mb-2 text-xs font-bold uppercase tracking-wide text-red-600">{video.category}</p>
              <h2 class="text-lg font-bold text-slate-900">{video.title}</h2>
              <p class="mt-2 text-sm text-slate-600">{video.description}</p>
            </div>
            <div class="px-5 py-3 bg-slate-50 border-t border-slate-200">
              <a href={'https://www.youtube.com/watch?v=' + video.youtubeId} target="_blank" rel="noopener noreferrer"
                class="text-sm font-semibold text-red-600 underline hover:text-red-700">Watch on YouTube <span class="sr-only">(opens in a new window)</span></a>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-10 text-sm text-slate-600">Read the <a href="/resources/faq/viz/" class="font-semibold text-red-600 underline">VIZ FAQ</a> for platform and licensing questions, or follow the <a href="/support/viz-beta/" class="font-semibold text-red-600 underline hover:text-red-700">VIZ installation &amp; evaluation instructions</a>.</p>
    </div>
  </section>

</SiteLayout>
