---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';

const videos = [
  {
    title: 'Getting Started with Power Surfacing VIZ',
    category: 'Start here',
    youtubeId: 'AM_ST-QX4Os',
    description: 'Start here for an introduction to Power Surfacing VIZ.',
  },
  {
    title: 'Getting Started with Materials in VIZ',
    category: 'Materials',
    youtubeId: 'M5niaTrDBIc',
    description: 'Learn how to get started with materials in Power Surfacing VIZ.',
  },
  {
    id: 'using-ai-materials',
    title: 'Using AI to manage materials',
    category: 'AI & Materials',
    src: '/Videos/UsingAIToManageMaterials-20261024.mp4',
    poster: '/assets/viz-using-ai-materials-poster.jpg',
    description: 'Learn how to use AI to manage materials in Power Surfacing VIZ.',
  },
];
const upcoming = [
  'Getting Started with Animation in VIZ',
  'Modifying Geometry in VIZ',
  'Using AI with VIZ for Animation',
];
---

<SiteLayout title="Power Surfacing VIZ Videos | Tutorials | nPower Software"
  description="Watch getting-started, materials, and AI tutorials for Power Surfacing VIZ. Find installation instructions and downloads, with more videos on the way.">
  <PageHero title="Power Surfacing VIZ Videos"
    subtitle="Learn Power Surfacing VIZ with step-by-step videos. Start with the introduction, then explore more tutorials as they become available."
    breadcrumbs={[{label:'Resources',path:'/resources/'},{label:'VIZ Videos'}]}
    actions={[{label:'Download VIZ Beta',path:'/pricing/downloads/#visualize'},{label:'Installation & Evaluation Guide',path:'/support/viz-beta/'}]} />

  <section class="py-12 md:py-16 bg-white" aria-label="VIZ video tutorials">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-10">
        {videos.map((video) => (
          <article id={video.id} class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <div class="p-5 sm:p-7">
              <p class="mb-2 text-xs font-bold uppercase tracking-wide text-red-600">{video.category}</p>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900">{video.title}</h2>
              <p class="mt-2 text-sm text-slate-600">{video.description}</p>
            </div>
            <div class="aspect-video bg-slate-950">
              {video.src ? (
                <video class="block h-full w-full object-contain" controls playsinline preload="metadata"
                  poster={video.poster} aria-label={video.title}>
                  <source src={video.src} type="video/mp4" />
                  Your browser does not support embedded video. <a href={video.src}>Watch the video</a>.
                </video>
              ) : (
              <iframe
                class="block h-full w-full border-0"
                src={'https://www.youtube-nocookie.com/embed/' + video.youtubeId}
                title={video.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
              )}
            </div>
            <div class="px-5 py-4 sm:px-7 bg-slate-50 border-t border-slate-200">
              <a href={video.src || 'https://www.youtube.com/watch?v=' + video.youtubeId} target="_blank" rel="noopener noreferrer"
                class="text-sm font-semibold text-red-600 underline hover:text-red-700">{video.src ? 'Open video in a new tab' : 'Watch on YouTube'} <span class="sr-only">(opens in a new tab)</span></a>
            </div>
          </article>
        ))}
      </div>

      <section class="mt-12" aria-labelledby="upcoming-viz-videos">
        <h2 id="upcoming-viz-videos" class="text-2xl font-bold text-slate-900">More VIZ videos coming soon</h2>
        <p class="mt-2 mb-6 text-sm text-slate-600">These tutorials will be available here when they are published.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {upcoming.map((title) => (
            <article class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5">
              <p class="mb-3 inline-flex rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">Coming soon</p>
              <h3 class="text-base font-bold text-slate-900">{title}</h3>
            </article>
          ))}
        </div>
      </section>

      <p class="mt-10 text-sm text-slate-600">Need help installing or starting your evaluation? Read the <a href="/support/viz-beta/" class="font-semibold text-red-600 underline hover:text-red-700">VIZ installation &amp; evaluation instructions</a>.</p>
    </div>
  </section>
</SiteLayout>
