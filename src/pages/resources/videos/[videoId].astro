---
import { SAMPLE_VIDEOS } from '@/lib/siteData.js';
import { getVideoStructuredData } from '@/seo-content/videoStructuredData.js';
import SiteLayout from '@/layouts/SiteLayout.astro';
import VideoDetailPage from '../_VideoDetail.jsx';

export function getStaticPaths() {
  return SAMPLE_VIDEOS.map((v) => ({
    params: { videoId: v.id },
    props: { videoId: v.id },
  }));
}

const { videoId } = Astro.props;
const video = SAMPLE_VIDEOS.find((v) => v.id === videoId);
const structuredData = getVideoStructuredData(video);
---
<SiteLayout
  title={video ? `${video.title}${video.id === 'v6' ? ' - Video' : ''} | nPower Software` : 'Video | nPower Software'}
  description={video ? `Watch ${video.title}, a ${video.type.toLowerCase()} about ${video.workflow} with ${video.product}.` : ''}
  image={video?.thumbnail}
>
  {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  <VideoDetailPage videoId={videoId} />
</SiteLayout>
