---
/**
 * BaseLayout.astro — full HTML shell for every page.
 * Props:
 *   title       — <title> and og:title
 *   description — meta description and og:description
 *   canonicalPath — path for canonical URL (defaults to current path)
 *   noindex     — set true to add noindex,nofollow
 *   image       — og:image URL
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
}

const SITE = 'https://www.npowersoftwarenew.com';
const DEFAULT_TITLE = 'Power Surfacing CAD, Sub-D & Reverse Engineering Software';
const DEFAULT_DESCRIPTION =
  'Power Surfacing provides standalone CAD and reverse-engineering software plus SOLIDWORKS add-ins for Sub-D modeling, scan-to-CAD, mesh-to-CAD, surfacing and solid modeling.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  noindex = false,
  image = '/assets/npower-branded-social.jpg',
} = Astro.props;

const canonical = SITE + (canonicalPath ?? Astro.url.pathname);
const ogImage = image.startsWith('http') ? image : SITE + image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="nPower Software" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Site-wide structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://www.npowersoftware.com/#organization",
      "name": "IntegrityWare, Inc.",
      "legalName": "IntegrityWare, Inc.",
      "url": SITE,
      "description": "IntegrityWare, Inc. develops advanced geometry and CAD software. nPower Software is a division of IntegrityWare, Inc.",
      "logo": {
        "@type": "ImageObject",
        "@id": SITE + "/#logo",
        "url": SITE + "/assets/npower-branded-social.jpg",
        "contentUrl": SITE + "/assets/npower-branded-social.jpg",
        "width": 1200,
        "height": 630,
        "caption": "nPower Software"
      },
      "image": { "@id": SITE + "/#logo" },
      "telephone": "+1-858-592-8866",
      "email": "info@npowersoftware.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "16486 Bernardo Center Drive, Suite 309",
        "addressLocality": "San Diego",
        "addressRegion": "CA",
        "postalCode": "92128",
        "addressCountry": "US"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "email": "sales@npowersoftware.com",
          "telephone": "+1-858-592-8866",
          "availableLanguage": "English"
        },
        {
          "@type": "ContactPoint",
          "contactType": "technical support",
          "email": "support@npowersoftware.com",
          "availableLanguage": "English"
        }
      ],
      "subOrganization": {
        "@type": "Organization",
        "@id": SITE + "/#npower-software",
        "name": "nPower Software",
        "description": "nPower Software is a division of IntegrityWare, Inc. Power Surfacing is its flagship product line.",
        "url": SITE,
        "parentOrganization": {
          "@id": "https://www.npowersoftware.com/#organization"
        },
        "logo": { "@id": SITE + "/#logo" },
        "sameAs": [
          "https://www.youtube.com/@npowersoftware6638"
        ],
        "brand": {
          "@type": "Brand",
          "@id": SITE + "/#power-surfacing",
          "name": "Power Surfacing",
          "description": "The flagship product line of nPower Software.",
          "logo": { "@id": SITE + "/#logo" }
        }
      },
      "knowsAbout": [
        "CAD software",
        "Subdivision surface modeling",
        "Reverse engineering",
        "Scan-to-CAD",
        "Mesh-to-CAD",
        "NURBS surfacing",
        "SOLIDWORKS add-ins"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": SITE + "/#website",
      "name": "nPower Software - Power Surfacing",
      "url": SITE,
      "publisher": { "@id": SITE + "/#npower-software" },
      "inLanguage": "en-US"
    })} />

    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Scroll-reveal: add is-visible when .reveal enters the viewport -->
    <script>
      (function () {
        if (typeof IntersectionObserver === 'undefined') {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
