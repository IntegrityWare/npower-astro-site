---
/**
 * BaseLayout.astro — full HTML shell for every page.
 * Props:
 *   title       — <title> and og:title
 *   description — meta description and og:description
 *   noindex     — set true to add noindex,nofollow
 *   image       — og:image URL
 *
 * Canonical is always self-referencing: the absolute URL of the current page
 * (with trailing slash), never a different path.
 */
import '../styles/global.css';
import { withTrailingSlash } from '../lib/urls.js';
import {
  SITE_URL,
  ORGANIZATION_ID,
  absoluteUrl,
  siteId,
} from '../lib/siteUrl.js';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const SITE = SITE_URL;
const DEFAULT_TITLE = 'Power Surfacing CAD, Sub-D & Reverse Engineering Software';
const DEFAULT_DESCRIPTION =
  'Power Surfacing provides standalone CAD and reverse-engineering software plus SOLIDWORKS add-ins for Sub-D modeling, scan-to-CAD, mesh-to-CAD, surfacing and solid modeling.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  image = '/assets/npower-branded-social.jpg',
} = Astro.props;

const path = withTrailingSlash(Astro.url.pathname);
const canonical = new URL(path, SITE + '/').href;
const ogImage = image.startsWith('http') ? image : new URL(image, SITE + '/').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="nPower Software" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Site-wide structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": ORGANIZATION_ID,
      "name": "IntegrityWare, Inc.",
      "legalName": "IntegrityWare, Inc.",
      "url": `${SITE}/`,
      "description": "IntegrityWare, Inc. develops advanced geometry and CAD software. nPower Software is a division of IntegrityWare, Inc.",
      "foundingDate": "1996",
      "founder": {
        "@type": "Person",
        "@id": absoluteUrl("/about#gary-crocker"),
        "name": "Gary Crocker",
        "jobTitle": "Founder and Chief Technology Officer",
        "description": "Mathematician and computer systems engineer specializing in computer graphics and geometric modeling. Gary Crocker founded IntegrityWare, Inc. in 1996.",
        "alumniOf": [
          {
            "@type": "CollegeOrUniversity",
            "name": "University of Maine at Orono"
          },
          {
            "@type": "CollegeOrUniversity",
            "name": "Rensselaer Polytechnic Institute"
          }
        ],
        "knowsAbout": [
          "Computer graphics",
          "Geometric modeling",
          "CAD software",
          "Solids# geometric modeling kernel"
        ],
        "worksFor": {
          "@id": ORGANIZATION_ID
        }
      },
      "employee": [
        {
          "@id": absoluteUrl("/about#gary-crocker")
        },
        {
          "@type": "Person",
          "@id": absoluteUrl("/about#david-gill"),
          "name": "David Gill",
          "jobTitle": "President",
          "worksFor": {
            "@id": ORGANIZATION_ID
          }
        },
        {
          "@type": "Person",
          "@id": absoluteUrl("/about#dahjiun-wang"),
          "name": "Dahjiun Wang",
          "jobTitle": "Co-founder and Director of Consulting",
          "description": "Dahjiun Wang co-founded IntegrityWare, Inc. in 1996 and serves as Director of Consulting.",
          "alumniOf": {
            "@type": "CollegeOrUniversity",
            "name": "Arizona State University"
          },
          "worksFor": {
            "@id": ORGANIZATION_ID
          }
        }
      ],
      "mainEntityOfPage": {
        "@id": absoluteUrl("/about#webpage")
      },
      "logo": {
        "@type": "ImageObject",
        "@id": siteId("logo"),
        "url": absoluteUrl("/assets/npower-branded-social.jpg"),
        "contentUrl": absoluteUrl("/assets/npower-branded-social.jpg"),
        "width": 1200,
        "height": 630,
        "caption": "nPower Software"
      },
      "image": { "@id": siteId("logo") },
      "telephone": "+1-858-592-8866",
      "email": "info@npowersoftware.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "16486 Bernardo Center Drive, Suite 309",
        "addressLocality": "San Diego",
        "addressRegion": "CA",
        "postalCode": "92128",
        "addressCountry": "US"
      },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "email": "sales@npowersoftware.com",
          "telephone": "+1-858-592-8866",
          "availableLanguage": "English"
        },
        {
          "@type": "ContactPoint",
          "contactType": "technical support",
          "email": "support@npowersoftware.com",
          "availableLanguage": "English"
        }
      ],
      "subOrganization": {
        "@type": "Organization",
        "@id": siteId("npower-software"),
        "name": "nPower Software",
        "description": "nPower Software is a division of IntegrityWare, Inc. Power Surfacing is its flagship product line.",
        "url": `${SITE}/`,
        "parentOrganization": {
          "@id": ORGANIZATION_ID
        },
        "logo": { "@id": siteId("logo") },
        "sameAs": [
          "https://www.youtube.com/@npowersoftware6638"
        ],
        "brand": {
          "@type": "Brand",
          "@id": siteId("power-surfacing"),
          "name": "Power Surfacing",
          "description": "The flagship product line of nPower Software.",
          "logo": { "@id": siteId("logo") }
        }
      },
      "knowsAbout": [
        "CAD software",
        "Subdivision surface modeling",
        "Reverse engineering",
        "Scan-to-CAD",
        "Mesh-to-CAD",
        "NURBS surfacing",
        "SOLIDWORKS add-ins",
        "Solids# geometric modeling kernel"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": siteId("website"),
      "name": "nPower Software - Power Surfacing",
      "url": `${SITE}/`,
      "publisher": { "@id": siteId("npower-software") },
      "inLanguage": "en-US"
    })} />

    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Scroll-reveal: add is-visible when .reveal enters the viewport -->
    <script>
      (function () {
        if (typeof IntersectionObserver === 'undefined') {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
