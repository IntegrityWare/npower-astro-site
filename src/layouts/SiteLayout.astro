---
/**
 * SiteLayout.astro — wraps page content with the fixed Navbar and Footer.
 * All page meta props are forwarded to BaseLayout.
 * Canonical is always self-referencing (set from the current URL in BaseLayout).
 */
import BaseLayout from './BaseLayout.astro';
import NavbarIsland from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const { title, description, noindex, image } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  image={image}
>
  <NavbarIsland pathname={pathname} client:load />
  <main class="flex-1 pt-24 flex flex-col min-h-screen">
    <slot />
  </main>
  <Footer />
</BaseLayout>
