{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "npower-astro-site",
  "main": "worker/index.mjs",
  "account_id": "0adec197ebe274768b80ef1dc2fb448e",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/store/*",
      "/api/trials/*",
      "/api/live-store/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "npower-store-sandbox",
      "database_id": "aa9214a3-4df5-4962-9fc5-74e8b6c5bd31",
      "migrations_dir": "migrations"
    },
    {
      "binding": "STORE_LIVE_DB",
      "database_name": "npower-store-live",
      "database_id": "0a346112-5702-4f63-b4dc-10b99101f00e",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": [
        "gcrocker61@gmail.com"
      ],
      "allowed_sender_addresses": [
        "licenses@npowersoftwarenew.com"
      ]
    }
  ],
  "vars": {
    "STORE_ORIGIN": "https://www.npowersoftwarenew.com",
    "SANDBOX_EMAIL": "gcrocker61@gmail.com",
    "EMAIL_FROM": "licenses@npowersoftwarenew.com",
    "STORE_ENABLED": "true",
    "EMAIL_ENABLED": "true",
    "LIFECYCLE_ENABLED": "true",
    "TRIALS_ENABLED": "true",
    "TRIAL_PUBLIC_SIGNUP": "true",
    "TRIAL_EMAIL_HOURLY_LIMIT": "100",
    "TRIAL_EMAIL_DAILY_LIMIT": "500",
    "TRIAL_ORIGIN": "https://www.npowersoftware.com",
    "TRIAL_EMAIL_FROM": "support@npowersoftware.com",
    "TRIAL_SMTP_HOST": "mail.npowersoftware.com",
    "TRIAL_SMTP_PORT": "465",
    "TRIAL_SMTP_USER": "dgill@npowersoftware.com",
    "TRIAL_TEST_EMAIL": "gcrocker61@gmail.com",
    "TRIAL_LEGACY_ORIGIN": "https://www.npowersoftwarenew.com",
    "LIVE_STORE_ENABLED": "false",
    "LIVE_LIFECYCLE_ENABLED": "false",
    "LIVE_STORE_ORIGIN": "https://www.npowersoftware.com",
    "LIVE_STORE_PRODUCTS": "viz",
    "STORE_LIVE_EMAIL_FROM": "support@npowersoftware.com",
    "STRIPE_LIVE_ACCOUNT_ID": "acct_1UQGwRFQQ1xhc2ph",
    "STRIPE_LIVE_PRICE_IDS": "{\"viz\":{\"product\":\"prod_VR9RcZky3Oi0NR\",\"prices\":{\"annual_node_locked\":\"price_1UTpP9FQQ1xhc2phnxgfITzC\",\"annual_floating\":\"price_1UTpP9FQQ1xhc2phW2Jt9vO2\",\"perpetual_node_locked\":\"price_1UTqGSFQQ1xhc2phMSDGib0q\",\"perpetual_floating\":\"price_1UTpP9FQQ1xhc2phPFSpHZxz\"},\"maintenance\":{\"product\":\"prod_VRA3EvStWEI3jE\",\"price\":\"price_1UTpPQFQQ1xhc2phDwlyx22p\"}}}",
    "LIVE_PURCHASE_TEST_ENABLED": "true",
    "STRIPE_LIVE_TEST_PRICE_ID": "price_1UTpP9FQQ1xhc2phFLqBhsXn"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "2-59/5 * * * *"
    ]
  }
}
