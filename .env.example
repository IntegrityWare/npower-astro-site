# Current public host for canonicals, OG tags, sitemap, and page JSON-LD.
# Staging (default if unset): https://www.npowersoftwarenew.com
# Production launch:          https://www.npowersoftware.com
PUBLIC_SITE_URL=https://www.npowersoftwarenew.com

# Stable Organization entity URL used in JSON-LD @id values.
# Can remain the final brand domain while the site is on a temporary host.
PUBLIC_ORGANIZATION_URL=https://www.npowersoftware.com

# Stripe storefront that the Viz, Studio, and RE Studio Buy buttons and the header
# Cart link point to (/buy/viz, /buy/studio, /buy/studio_re, /cart). Leave unset to
# hide them. The Cart link only shows when the storefront has set an
# npower_cart_count cookie above 0, so the storefront must share a host or parent
# domain with this site. Local preview: http://127.0.0.1:4244
PUBLIC_STOREFRONT_URL=
